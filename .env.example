# Groq free tier (https://console.groq.com) — used by Phase 3 offline scripts
GROQ_API_KEY=gsk_your_key_here
# Also accepted (typo-tolerant): Gork_API_KEY

# High-TPM default avoids llama-3.1-8b-instant's 6K TPM ceiling.
# Good options: groq/compound (70K TPM), groq/compound-mini (70K), llama-3.3-70b-versatile (12K)
GROQ_MODEL=groq/compound

# Nudges: false = use root nudges.json (MVP). true = live Groq + Docs/nudge_prompt.md
USE_LLM_NUDGES=false
# VITE_USE_LLM_NUDGES=false

# Live deck LLM (Groq on every hand). Default false — probe + frozen allocator for MVP.
USE_LLM_DECK=false
# VITE_USE_LLM_DECK=false
