# Groq free tier (https://console.groq.com)
# Server-only — used by /api/groq/chat (Vercel) and Vite middleware. Never use VITE_GROQ_API_KEY.
GROQ_API_KEY=gsk_your_key_here
# Also accepted (typo-tolerant): Gork_API_KEY

GROQ_MODEL=llama-3.3-70b-versatile

# Request header guard (x-groq-proxy-secret). Injected into the client at build time — light abuse deterrence only.
GROQ_PROXY_SECRET=change-me-to-a-long-random-string

# Nudges: false = nudges.json. true = live Groq via /api/groq/chat
USE_LLM_NUDGES=false

# Live deck LLM. Default false — frozen allocator for MVP.
USE_LLM_DECK=false
